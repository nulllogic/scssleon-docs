---
const { title, badge, class: className, ...rest } = Astro.props;
const [attr, cond] = Object.entries(Astro.props).at(-1);
---
<a href="#"
   class:list={[
     'btn',
     { 'small': Astro.props?.small },
     className,
     { 'has-tooltip': Astro.props?.tooltip },
   ]}
   {...rest}
>
  {Astro.props?.icon === 'clipboard' && (
          <span class={'icon_wrapper'}>
              <svg class={'icon copy'} xmlns="http://www.w3.org/2000/svg"
                   width="16"
                   height="16" viewBox="0 0 16 16" fill="none"
                   stroke="currentColor" stroke-width="2" stroke-linecap="round"
                   stroke-linejoin="round">
              <path stroke-width="1.5" d="M6.7,5.3h6.7c0.7,0,1.3,0.6,1.3,1.3v6.7c0,0.7-0.6,1.3-1.3,1.3H6.7c-0.7,0-1.3-0.6-1.3-1.3V6.7
	C5.3,5.9,5.9,5.3,6.7,5.3z"/>
              <path stroke-width="1.5"
                    d="M2.7,10.7c-0.7,0-1.3-0.6-1.3-1.3V2.7c0-0.7,0.6-1.3,1.3-1.3h6.7c0.7,0,1.3,0.6,1.3,1.3"/>
          </svg>
          <svg class="icon complete" aria-hidden="true" height="16"
               viewBox="0 0 16 16" width="16">
              <path d="M14.3,2.7c0.2,0.3,0.3,1.1-0.2,1.7l-7.4,8.2c-0.3,0.3-0.8,0.3-1.1,0L2.3,8.9C1.7,8.3,1.9,7.6,2.2,7.3
	c0.2-0.2,0.9-0.6,1.3-0.1l2.7,3l6.7-7.4C13.3,2.3,14,2.4,14.3,2.7z"/>
          </svg>
          </span>
  )}
  {Astro.props?.icon === 'outline' && (
          <span class={'icon_wrapper'}>
            <svg viewBox="0 0 14 14" width="17" height="17"
                 xmlns="http://www.w3.org/2000/svg" fill="none" class={'icon'}>
                <path d="M2 2.004v2H1v-2.5a.5.5 0 01.5-.5H4v1H2zM1 9.004v-4h1v4H1zM1 10.004v2.5a.5.5 0 00.5.5H4v-1H2v-2H1zM10 13.004h2.5a.5.5 0 00.5-.5v-2.5h-1v2h-2v1zM12 4.004h1v-2.5a.5.5 0 00-.5-.5H10v1h2v2zM9 12.004v1H5v-1h4zM9 1.004v1H5v-1h4zM13 9.004h-1v-4h1v4zM7 8.004a1 1 0 100-2 1 1 0 000 2z"
                      fill="currentColor"></path>
            </svg>
            <span class="indicator"/>
          </span>
  )}
  {Astro.props?.icon === 'color_scheme' && (
          <span class={'icon_wrapper'}>
            <svg viewBox="0 0 24 24" width="17" height="17" class="icon dark"
                 fill="none"
                 stroke-width="1.5" stroke="currentColor">
                <path d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
            </svg>
            <svg viewBox="0 0 24 24" width="17" height="17"
                 xmlns="http://www.w3.org/2000/svg" class="icon light"
                 fill="none"
                 stroke="currentColor"
                 stroke-linecap="round" stroke-linejoin="round"
                 stroke-width="1">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </span>
  )}

  {Astro.props?.icon === 'html5' && (
          <span class={'icon_wrapper'}>
            <svg fill="currentColor" width="18px" height="18px" class="icon" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg"><path d="M6.32 5.5l1.759 19.774 7.893 2.226 7.948-2.226L25.68 5.5H6.32zm15.537 6.449H12.59l.207 2.488h8.854l-.687 7.479-4.937 1.361v.014h-.055l-4.978-1.375-.303-3.821h2.406l.179 1.925 2.695.728 2.708-.728.303-3.136h-8.415l-.645-7.341h12.155l-.22 2.406z"/></svg>
          </span>
  )}

  {Astro.props?.icon === 'scss' && (
          <span class={'icon_wrapper'}>
            <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="18px"
                 height="18px" viewBox="0 0 24 24" fill="currentColor">
              <rect width="24" height="24" fill="none"/>
              <path d="M12,2A10,10,0,1,1,2,12,10,10,0,0,1,12,2M10,15.33a2.55,2.55,0,0,1,0,1.5c0,.05,0,.1-.06.17s0,.07-.07.12a2.5,2.5,0,0,1-.46.67c-.58.64-1.41.88-1.74.68s-.17-1.12.49-1.83a6.91,6.91,0,0,1,1.76-1.26h0l.08-.05m8.27-9c-.45-1.78-3.4-2.36-6.18-1.37A14,14,0,0,0,7.34,7.63c-1.53,1.44-1.78,2.69-1.68,3.21.34,1.84,2.88,3.05,3.92,3.94h0c-.3.15-2.54,1.28-3.08,2.44A1.62,1.62,0,0,0,7,19.45a3.16,3.16,0,0,0,3.41-1.38A3.44,3.44,0,0,0,10.75,15a4.34,4.34,0,0,1,1.53-.08c1.76.21,2.1,1.3,2,1.76a1.16,1.16,0,0,1-.55.79c-.12.07-.16.1-.15.16s.07.08.17.06a1.36,1.36,0,0,0,1-1.22c0-1.08-1-2.28-2.81-2.25a4.84,4.84,0,0,0-1.56.22l-.08-.09c-1.13-1.2-3.21-2-3.12-3.67,0-.59.23-2.13,4-4,3.08-1.54,5.55-1.12,6-.17.61,1.33-1.32,3.82-4.52,4.18a2.44,2.44,0,0,1-2-.51c-.17-.17-.19-.2-.25-.17s0,.23,0,.33a2,2,0,0,0,1.15.91,6.18,6.18,0,0,0,3.76-.37C17.2,10.12,18.72,8,18.27,6.28Z"/>
            </svg>
          </span>
  )}

  {Astro.props?.icon === 'js' && (
          <span class={'icon_wrapper'}>
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor"
                 width="18px" height="18px" viewBox="0 0 512 512"><path
                    d="M429.76,130.07,274.33,36.85a37,37,0,0,0-36.65,0L82.24,130.06A38.2,38.2,0,0,0,64,162.83V349a38.26,38.26,0,0,0,18.24,32.8L123,406.14l.23.13c20.58,10.53,28.46,10.53,37.59,10.53,32.14,0,52.11-20.8,52.11-54.29V182a8.51,8.51,0,0,0-8.42-8.58H182.13a8.51,8.51,0,0,0-8.42,8.58V362.51a15,15,0,0,1-6.85,13.07c-5.9,3.6-14.47,2.84-24.14-2.15l-39.06-23.51a1.1,1.1,0,0,1-.48-.92V165.46a1.32,1.32,0,0,1,.59-1.06l151.84-93a.82.82,0,0,1,.73,0l151.93,93a1.34,1.34,0,0,1,.55,1.1V349a1.28,1.28,0,0,1-.45,1L256.31,440.65a1.22,1.22,0,0,1-.8,0l-38.83-23.06a7.8,7.8,0,0,0-7.83-.41l-.34.2c-10.72,6.35-13.6,8-23.54,11.62-1.62.59-5.43,2-5.76,5.77s3.29,6.45,6.51,8.32l51.9,31.87a35.67,35.67,0,0,0,18.3,5.07l.58,0h0a35.87,35.87,0,0,0,17.83-5.07l155.43-93.13A38.37,38.37,0,0,0,448,349V162.83A38.21,38.21,0,0,0,429.76,130.07Z"/><path
                    d="M307.88,318.05c-37.29,0-45.24-10.42-47.6-27.24a8.43,8.43,0,0,0-8.22-7.32h-19.8a8.44,8.44,0,0,0-8.26,8.58c0,14.58,5.12,62.17,83.92,62.17h0c24.38,0,44.66-5.7,58.63-16.49S388,311.26,388,292.55c0-37.55-24.5-47.83-72.75-54.55-49.05-6.82-49.05-10.29-49.05-17.89,0-5.47,0-18.28,35.46-18.28,25.23,0,38.74,3.19,43.06,20a8.35,8.35,0,0,0,8.06,6.67h19.87a8.24,8.24,0,0,0,6.16-2.86,8.91,8.91,0,0,0,2.12-6.44c-2.57-35.55-28.56-53.58-79.24-53.58-46.06,0-73.55,20.75-73.55,55.5,0,38.1,28.49,48.87,71.29,53.33,50,5.17,50,12.71,50,19.37C349.46,304.2,345.15,318.05,307.88,318.05Z"/></svg>
          </span>
  )}


  {Astro.props?.icon === 'clipboard' && !Astro.props?.small && (
          <span class="text">Copy</span>
  )}
  {Astro.props?.title && (
          <span class="text">{title}</span>
  )}
  {Astro.props?.tooltip && (
          <span class="tooltip">
            <span>Copied</span>
          </span>
  )}
</a>

<style lang="scss">
  @use 'sass:list';
  @use 'sass:meta';
  @use 'sass:map';
  @use 'sass:string';

  @use '~/styles/app.scss' as app;

  $icon-clipboard: (
    _subclasses: (
      '&.clicked' : (
        --border : var(--hover-border)
      ),
      '&.clicked .icon.copy' : (
        visibility: hidden,
        filter: blur(0.75px),
        transform: scale(0.8),
      ),
      '&.clicked .icon.complete' : (
        filter: blur(0),
        transform: scale(1),
        opacity: 1,
        visibility: visible,
        _subclasses : (
          ':global(path)' : (
            animation: icon_reveal .25s cubic-bezier(0, -0.85, .9, .79) 1,
            _animations: (
              'icon_reveal' : (
                'from' : (
                  clip-path: inset(0 100% 0 0),
                ),
                'to' : (
                  clip-path: inset(0 0 0 0),
                )
              )
            ),
          )
        )
      ),
      '&.clicked .tooltip' : (
        display: block,
        opacity: 1,
        transform: translateY(5px),
        _atrule : (
          '@starting-style' : (
            opacity: 0,
            transform: translateY(-3px)
          )
        ),
      ),
      '.icon.copy' : (
        display: inherit,
        opacity: 1,
        visibility: visible,
        transform: scale(1),
        filter: blur(0),
        transition: string.unquote("filter 0.25s ease-out, opacity 0.15s ease-out, transform 0.15s ease-out, visibility 0.15s ease-out"),
      ),
      '.icon.complete' : (
        position: absolute,
        top: 0,
        left: 0,
        bottom: 0,
        right: 0,
        width: 100%,
        height: 100%,
        transform: scale(0),
        transition: string.unquote("filter 0.15s ease-out, opacity 0.15s ease-out, transform 0.15s ease-out, visibility 0.2s ease-out"),
        filter: blur(4px),
        opacity: 0,
        visibility: hidden,
        _subclasses: (
          ':global(path)' : (
            fill : oklch(0.695 0.181 145.621)
          )
        )
      ),
    )
  );

  $icon-color-scheme: (
    _subclasses: (
      '&.clicked' : (
        _subclasses: (
          '.icon.light' : (
            opacity: 0,
            animation: icon-enter 0.2s forwards,
          ),
          '.icon.dark' : (
            opacity: 0,
            animation: icon-enter 0.2s forwards,
          )
        )
      ),
      '.icon_wrapper' : (
        position: relative,
        width: 17px,
        height: 17px,
      ),
      '.icon' : (
        display: none,
        width: 20px,
        height: 20px,
        left: -2px,
        top: -1px,
        _animations : (
          'icon-enter' : (
            '0%' : (
              opacity: 0,
              transform:rotate(180deg)
            ),
            '100%' : (
              opacity: 1,
              transform:rotate(0deg)
            )
          ),
        ),
      ),
      'svg' : (
        transform: rotate(0),
        opacity: 1,
        position: absolute,
        transition: string.unquote('transform 0.2s ease-in, opacity 0.2s ease-in'),
      ),
      '&.dark .icon.dark' : (
        display: inline-block
      ),
      '&.light .icon.light' : (
        display: inline-block
      ),
    )
  );

  $icon-outline: (
    _subclasses: (
      '.icon_wrapper' : (
        position: relative,
        _subclasses: (
          '.indicator' : (
            position: absolute,
            bottom: -11px,
            width: 100%,
            height: 2px,
            background: oklch(0.695 0.181 145.621),
            border-radius: 2px,
            left: 0,
            opacity: 0,
            visibility: hidden,
            pointer-events: none,
            transition: string.unquote("filter 0.15s ease-out, opacity 0.15s ease-out, transform 0.15s ease-out, visibility 0.15s ease-out"),
            transform: translateY(-4px),
            filter: blur(1px)
          )
        )
      ),
      '&.clicked' : (
        /*box-shadow: var(--active-shadow),*/
        _subclasses: (
          '.icon_wrapper .indicator' : (
            transform: translateY(0),
            opacity: 1,
            visibility: visible,
            filter: blur(0)
          ),
          '.icon' : (
            // Drop shadow to the icon
            /*filter: drop-shadow(1px 1px 1px oklch(0 0 0 / 70.17%)),*/
            _subclasses: (
              ':global(path)' : (
                fill : oklch(0.695 0.181 145.621),
              )
            )
          ),
        )
      ),
    )
  );

  $icon-html5: (
    _subclasses: (
      '.icon_wrapper' : (
        position: relative,
        width: 18px,
        height: 18px,
        pointer-events: none,
        _subclasses: (
          '.icon' : (

          )
        )
      )
    )
  );

  $button: (
    _subclasses : (
      '&.small' : (
        --padding: .325rem
      ),
      '.icon_wrapper' : (
        display: block,
        position: relative,
      ),
      '&.color_scheme' : $icon-color-scheme,
      '&.clipboard': $icon-clipboard,
      '&.outline': $icon-outline,
      '&.html5': $icon-html5,
    )
  );

  @include app.generate-component(
    $button,
    '.btn',
    app.$config,
    app.$theme
  );
</style>