---

---
<div class:list={['btn', { 'small': Astro.props?.small }]}>
  {Astro.props?.icon === 'clipboard' && (
          <svg class={'icon'} xmlns="http://www.w3.org/2000/svg" width="16"
               height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round"
               stroke-linejoin="round">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
              <path stroke="rgb(74, 109, 71)" fill="none" fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
          </svg>
  )}
  {Astro.props?.icon === 'outline' && (
          <svg viewBox="0 0 14 14" width="16" height="16"
               xmlns="http://www.w3.org/2000/svg" fill="none" class={'icon'}>
              <path d="M2 2.004v2H1v-2.5a.5.5 0 01.5-.5H4v1H2zM1 9.004v-4h1v4H1zM1 10.004v2.5a.5.5 0 00.5.5H4v-1H2v-2H1zM10 13.004h2.5a.5.5 0 00.5-.5v-2.5h-1v2h-2v1zM12 4.004h1v-2.5a.5.5 0 00-.5-.5H10v1h2v2zM9 12.004v1H5v-1h4zM9 1.004v1H5v-1h4zM13 9.004h-1v-4h1v4zM7 8.004a1 1 0 100-2 1 1 0 000 2z"
                    fill="currentColor"></path>
          </svg>
  )}
  {Astro.props?.icon === 'color_scheme' && (
          <svg viewBox="0 0 24 24" width="16" height="16" class="icon white" fill="none"
               stroke-width="1.5" stroke="currentColor">
              <path d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
          </svg>
          <svg viewBox="0 0 24 24" width="16" height="16"
               xmlns="http://www.w3.org/2000/svg" class="icon dark" fill="none"
               stroke="currentColor"
               stroke-linecap="round" stroke-linejoin="round" stroke-width="1">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
  )}
  {!Astro.props?.small && (
          <span class="text">Copy</span>
  )}
</div>

<style lang="scss">
  @use 'sass:list';
  @use 'sass:meta';
  @use 'sass:map';

  @use '~/styles/app.scss' as app;

  $button: (
    _subclasses : (
      '&.small' : (
        --padding: .325rem
      ),
      '.icon' : (
        width: 16px,
        height: 16px,
      )
    )
  );

  @include app.generate-component(
    $button,
    '.btn',
    app.$config,
    app.$theme
  );
</style>