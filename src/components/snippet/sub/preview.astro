---
import { Iframe } from './';
const { url, min_height } = Astro.props;

const html = await Astro.slots.render('html');
const scss = await Astro.slots.render('scss');
const js = await Astro.slots.render('js');
---
<xii-preview class="preview">
    <Iframe min_height={min_height}>
        <Fragment slot="html" set:html={html} is:raw/>
        <Fragment slot="scss" set:html={scss} is:raw/>
        <Fragment slot="js" set:html={js} is:raw/>
    </Iframe>
    <div class="resizer"><span class="drag"><span
            class="el"/></span></div>
    <canvas class="canvas" slot="canvas"/>
</xii-preview>

<style lang="scss">
  @use 'sass:map';
  @use 'sass:string';

  @use '~/styles/app.scss' as app;

  $preview-canvas: (
    position: absolute,
    top:-50px,
    right:-50px,
    bottom:-50px,
    left:-50px,
    width: calc(100% + 100px),
    height: calc(100% + 100px),
    pointer-events: none
  );

  $preview-resizer-dragging-element: (
    position: absolute,
    left: unset,
    right: 0,
    top: 0,
    bottom: 0,
    -webkit-user-select: none,
    user-select: none,
    display: flex,
    height: 100%,
    align-items: center,
    _subclasses: (
      '.drag' : (
        padding: 0.5rem,
        touch-action: pan-y,
        cursor: ew-resize,
        display: block,
        user-select: none,
        _subclasses: (
          '&:hover .el' : (
            transform: scale(1.25),
            background: rgba(109, 120, 135, 0.75),
          ),
          '.el' : (
            background: rgba(100, 116, 139, 0.6),
            border-radius: 10px,
            width: 0.375rem,
            height: 2rem,
            display: block,
            transition: string.unquote('0.25s background-color, 0.25s transform'),
          )
        )
      ),
    ),
    _responsive : (
      md: (
        left: 100%,
        right: unset,
      )
    )
  );

  $preview: (
    position: relative,
    background: var(--background),
    display: block,
    _colors : (
      light : (
        background : string.unquote('rgba(55, 241, 14, 0.09) linear-gradient(135deg, rgba(219, 226, 216, 0.45) 10%, rgba(0, 0, 0, 0) 0, #0000 50%, rgba(219, 226, 216, 0.45) 0, rgba(219, 226, 216, 0.45) 60%, rgba(0, 0, 0, 0) 0, rgba(0, 0, 0, 0)) repeat 100% /7.07px 7.07px'),
      ),
      dark : (
        background : string.unquote('rgba(19, 38, 81, 0.1) linear-gradient(135deg, rgba(19, 83, 14, 0.45) 10%, rgba(0, 0, 0, 0) 0, #0000 50%, rgba(19, 83, 14, 0.45) 0, rgba(19, 83, 14, 0.45) 60%, rgba(0, 0, 0, 0) 0, rgba(0, 0, 0, 0)) repeat 100% /7.07px 7.07px'),
      )
    ),
    _subclasses: (
      '.wrapper' : (
        display: flex,
        flex-direction: column,
        height: auto,
        overflow: auto,
      ),
      '&.is_resizing' : (
        pointer-events: none,
        _subclasses: (
          '.drag .el' : (
            transform: scale(1.25),
            background: rgba(109, 120, 135, 0.75),
          )
        )
      ),
      '.resizer' : $preview-resizer-dragging-element,
      '.canvas' : $preview-canvas,
    ),
  );

  @include app.generate-component(
    $preview,
    '.preview',
    app.$config,
    app.$theme
  );

</style>

<script>

  // import { destroy, init, rescale } from "../utils/measure/canvas.ts";
  import {
    drawBoxModel,
    drawSelectedElement2,
  } from '../utils/measure/visualizer.ts';
  import { deepElementFromPoint } from '../utils/measure/search.ts';
  //

  // let nodeAtPointerRef;
  // const pointer = { x: 0, y: 0 };

  class SnippetPreview extends HTMLElement {

    constructor () {
      super();
      // 1. Create the shadow root and a slot
      const shadow = this.attachShadow({ mode: 'open' });
      shadow.innerHTML = `<slot />`;

      const sheet = new CSSStyleSheet();
      sheet.replaceSync(`
          canvas {
            position: absolute;
            top:-50px;
            right:-100px;
            bottom:-50px;
            left:-100px;
            width: calc(100% + 200px);
            height: calc(100% + 100px);
            pointer-events: none;
          }
      `);

      shadow.adoptedStyleSheets = [sheet];

      this.shadowRoot?.appendChild(this.querySelector('iframe'));
      this.iframe = this.shadowRoot?.querySelector('iframe');
      this.iframe.addEventListener('load', this._iframe_load_event.bind(this));

      this.canvas = document.createElement('canvas');
      this.ctx = this.canvas.getContext('2d');

      this.shadowRoot.appendChild(this.canvas);
    }

    _iframe_load_event (e) {
      this.iframe.style.height = this.iframe.contentDocument.body.scrollHeight +
        'px';
      this.iframe.style.visibility = 'visible';

      const resizeObserver = new ResizeObserver((entries) => {
        for (const entry of entries) {
          this.iframe.style.height = entry.borderBoxSize[0].blockSize + 'px';
        }
      });

      resizeObserver.observe(this.iframe.contentDocument.body,
        { box: 'border-box' });
    }

    // _iframe_load_event (e) {
    //   // Bind the mouseover event to the iframe's internal document
    //   this.iframe.contentDocument.addEventListener('pointerover',
    //     this._iframe_point_over_event.bind(this));
    // }

    _iframe_point_over_event (e) {
      window.requestAnimationFrame(() => {
        e.stopPropagation();
        this._find_and_draw_element(e.clientX, e.clientY);
      });
    }

    _deep_element_from_point (x, y) {
      const element = this.iframe.contentWindow.document.elementFromPoint(x,
        y) as HTMLElement;

      if (element.tagName === 'BODY') return;

      const crawlShadows = (node: HTMLElement): HTMLElement => {
        if (node && node.shadowRoot) {
          // elementFromPoint() doesn't exist in ShadowRoot type
          const nestedElement = (node.shadowRoot as any).elementFromPoint(x, y);

          // Nested node is same as the root one
          if (node.isEqualNode(nestedElement)) {
            return node;
          }
          // The nested node has shadow DOM too so continue crawling
          if (nestedElement.shadowRoot) {
            return crawlShadows(nestedElement);
          }
          // No more shadow DOM
          return nestedElement;
        }

        return node;
      };

      const shadowElement = crawlShadows(element);

      return shadowElement || element;
    }

    _find_and_draw_element (x, y) {
      let nodeAtPointerRef = this._deep_element_from_point(x, y);
      this._draw(drawBoxModel(nodeAtPointerRef));
    }

    _draw (callback) {

      this.height = this.iframe.contentWindow.document.body.offsetHeight + 100;
      this.width = this.iframe.contentWindow.document.body.scrollWidth + 200;

      this.canvas.width = this.width;
      this.canvas.height = this.height;

      const scale = window.devicePixelRatio;
      this.canvas.width = Math.floor(this.width * scale);
      this.canvas.height = Math.floor(this.height * scale);

      this.ctx.scale(window.devicePixelRatio, window.devicePixelRatio);

      this.ctx.clearRect(0, 0, this.width ?? 0, this.height ?? 0);
      // Set color to black (or any color you want)
      this.ctx.fillStyle = 'red';

      callback(this.ctx);
    }

    disconnectedCallback () {
      this.iframe.removeEventListener('load',
        this._iframe_load_event.bind(this));
    }
  }

  // Register the element with the browser
  customElements.define('xii-preview', SnippetPreview);
</script>