---
import { Preview } from './';
import { extractor } from './utils/extractor.ts';

import { codeToHtml } from 'shiki';

import type {
  ShikiTransformer,
  ThemeRegistration,
  ThemeRegistrationRaw,
} from 'shiki';

import {
  transformerNotationDiff,
  transformerNotationHighlight,
  transformerNotationFocus,
} from '@shikijs/transformers';

// then later you can use `highlighter.codeToHtml` synchronously
// with the loaded themes and languages.
const code2 = await codeToHtml(
  '// [!code highlight:5]\n' +
  'import {\n' +
  '  transformerNotationDiff,\n' +
  '  // ...\n' +
  '} from \'@shikijs/transformers\'\n' +
  'import {\n' +
  '  codeToHtml,\n' +
  '} from \'shiki\'\n' +
  '\n' +
  '// [!code highlight:3]\n' +
  'console.log(\'Highlighted\')\n' +
  'console.log(\'Highlighted\')\n' +
  'console.log(\'Highlighted\')\n' +
  'console.log(\'hewwo\') // [!code --]\n' +
  'console.log(\'hello\') // [!code ++]\n' +
  'const code = `console.log(\'hello\')`\n' +
  'const html = await codeToHtml(code, {\n' +
  '  lang: \'ts\',\n' +
  '  theme: \'nord\',\n' +
  '  transformers: [\n' +
  '    transformerNotationDiff(), // [!code highlight]\n' +
  '    // ...\n' +
  '  ],\n' +
  'import { codeToHtml } from \'shiki\'\n' +
  '\n' +
  'const code = await codeToHtml(\'foo\\bar\', {\n' +
  '  lang: \'js\',\n' +
  '  theme: \'vitesse-light\',\n' +
  '  transformers: [\n' +
  '    {\n' +
  '      code(node) {\n' +
  '        this.addClassToHast(node, \'language-js\')\n' +
  '      },\n' +
  '      line(node, line) {\n' +
  '        node.properties[\'data-line\'] = line\n' +
  '        if ([1, 3, 4].includes(line))\n' +
  '          this.addClassToHast(node, \'highlight\')\n' +
  '      },\n' +
  '      span(node, line, col) {\n' +
  '        node.properties[\'data-token\'] = `token:${line}:${col}`\n' +
  '      },\n' +
  '    },\n' +
  '  ]\n' +
  '})', {
    lang: 'javascript',
    themes: {
      light: 'github-light-default',
      dark: 'github-dark-default',
    },
    defaultColor: 'light-dark()',
    transformers: [
      transformerNotationDiff(),
      transformerNotationHighlight(),
      transformerNotationFocus(),
    ],
  });

// HTML
const html_rendered = (await Astro.slots.render('html'));
// SCSS
const scss_rendered = (await Astro.slots.render('scss'));
// JS
const js_rendered = (await Astro.slots.render('js'));

const {
  title = '',
  preview = false,
  file = null,
  min_height = '',
  inline = false,
  single = true,
  multi_line = true,
} = Astro.props;

const {
  html = null,
  scss = null,
  js = null,
  code = null,
} = await extractor(file, title);
---
<div class="snippet">
  123
</div>

<style lang="scss">
  @use 'sass:list';
  @use 'sass:string';
  @use 'sass:meta';
  @use 'sass:map';

  @use '~/styles/app.scss' as app;

  $snippet: (
    border-radius: 0.5rem,
    background: var(--background),
    box-shadow: var(--shadow),
    z-index: 1,
  );

  @include app.generate-component($snippet, 'snippet', app.$config, app.$theme);
</style>