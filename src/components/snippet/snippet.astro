---
import { extractor } from './utils/';
// HTML
const html_rendered = (await Astro.slots.render('html'));
// SCSS
const scss_rendered = (await Astro.slots.render('scss'));
// JS
const js_rendered = (await Astro.slots.render('js'));

const {
  title = '',
  preview = false,
  file = null,
  min_height = '',
  inline = false,
  single = false,
  multi_line = true,
  lang = 'js',
} = Astro.props;

const {
  html = null,
  scss = null,
  js = null,
  code = null,
} = await extractor(file, title);

import Button from './sub/button.astro';
import Code from './sub/code.astro';
import { component_classes } from './utils/classes_generator.ts';

// title={Astro.props.title}
// html={html}
// scss={scss}
// js={js}
// code={code}
// single={single}
// lang={lang}
const lines = code ? code.split(/\r\n|\r|\n/).length : null;
const scss_generated = scss ? component_classes(scss) : null;
---
<div class:list={['snippet', { 'single': single }]}>
  {(!single || (lines && lines > 1)) && (
          <div class="top">
              <div class="nav">
                  <div class="left">
                      <div class="title"
                           set:html={Astro.props.title.replace(/\*(.*?)\*/g,
                             '<span class="bold">$1</span>')}>
                      </div>
                  </div>
                  <div class="right">
                    {!code && (
                            <div class="btn-group separated" role="group"
                                 aria-label="Basic example"
                                 style="--xii-gap: .425rem;">
                                <Button small icon={'outline'}/>
                                <Button small icon={'color_scheme'}/>
                            </div>
                    )}
                  </div>
              </div>
          </div>
  )}

    <div class="middle">
      {preview && (
              <div class="preview">
                  <xii-preview>
                      <div slot="html" set:html={html}></div>
                    {scss && (
                            <style slot="scss" set:html={scss_generated}>
                            </style>
                    )}
                    {js && (
                      <script slot="js" set:html={js}></script>
                    )}
                  </xii-preview>
              </div>
      )}
      {code && (
              <Code code={code} lang={lang} single={single}
                    oneline={lines && lines === 1}/>
              <Button small={lines && lines === 1} icon={'clipboard'}/>
      )}
    </div>
  {!single && (
          <div class="bottom">
              <div class="nav">
                  <div class="left">
                      <div class="btn-group" role="group"
                           aria-label="Basic example">
                          <Button>HTML</Button>
                          <Button>SCSS</Button>
                          <Button>JS</Button>
                      </div>
                  </div>
                  <div class="right">
                      <Button>Right</Button>
                  </div>
              </div>
              <div class="tabs">
                  <div class="tab">
                      <Code code={html} lang={'html'}
                            show_line_numbers={true}/>
                  </div>
                  <div class="tab">
                      <Code code={scss} lang={'scss'}
                            show_line_numbers={true}/>
                  </div>
                  <div class="tab">
                      <Code code={js} lang={'js'} show_line_numbers={true}/>
                  </div>
              </div>
          </div>
  )}
</div>

<style lang="scss">
  @use 'sass:map';
  @use 'sass:string';

  @use '~/styles/app.scss' as app;

  $snippet-top: (
    background: #0d1117,
    border-radius: .425rem .425rem 0 0,
    padding: .525rem .825rem,
    border-bottom: 1px solid #333434,
    _subclasses : (
      '.nav' : (
        justify-content : space-between,
        _subclasses : (
          '.title' : (
            _subclasses : (
              ':global(.bold)' : (
                font-weight: 500,
                display: inline-block,
                padding: 0 .25rem,
              )
            )
          )
        )
      ),
    )
  );

  $snippet-middle: (
    border-radius: 0 0 0.425rem 0.425rem,
    position: relative,
    _subclasses : (
      '.preview' : (
        padding: 1rem .825rem,
        border-bottom: 1px solid #333434,
        background: var(--background),
        _colors : (
          light : (
            /*color: rgb(229, 236, 226),*/
            background : string.unquote('rgba(55, 241, 14, 0.09) linear-gradient(135deg, rgba(219, 226, 216, 0.45) 10%, rgba(0, 0, 0, 0) 0, #0000 50%, rgba(219, 226, 216, 0.45) 0, rgba(219, 226, 216, 0.45) 60%, rgba(0, 0, 0, 0) 0, rgba(0, 0, 0, 0)) repeat 100% /7.07px 7.07px'),
          ),
          dark : (
            background : string.unquote('rgba(19, 38, 81, 0.1) linear-gradient(135deg, rgba(19, 83, 14, 0.45) 10%, rgba(0, 0, 0, 0) 0, #0000 50%, rgba(19, 83, 14, 0.45) 0, rgba(19, 83, 14, 0.45) 60%, rgba(0, 0, 0, 0) 0, rgba(0, 0, 0, 0)) repeat 100% /7.07px 7.07px'),
          )
        )
      ),
      '> :global(.btn)' : (
        position: absolute,
        top: 8px,
        right: 8px,
        _subclasses : (
          '&.small' : (
            top: 50%,
            transform: translateY(-50%)
          )
        )
      )
    )
  );


  $snippet-bottom: (
    background: #0d1117,
    border-radius: 0 0 0.425rem 0.425rem,
    _subclasses : (
      '.nav' : (
        padding: 0 .825rem,
        justify-content : space-between,
        border-bottom: 1px solid #333434,
      ),
      '.tabs' : (
        _subclasses : (
          '.tab' : (
            _subclasses : (
              '&:first-child' : (
                display: block,
              )
            ),
            display: none
          )
        )
      )
    )
  );

  $snippet: (
    position: relative,
    z-index: 1,
    text-align: left,
    padding: 0,
    display: block,
    margin: 0,
    border: 1px solid #3d444d,
    border-radius: .425rem,
    _subclasses : (
      '.top' : $snippet-top,
      '.middle' : $snippet-middle,
      '.bottom' : $snippet-bottom,
      '&.single' : (
        _subclasses : (
          '.middle' : (
            border-radius: .425rem,
          )
        )
      )
    )
  );

  @include app.generate-component(
    $snippet,
    '.snippet',
    app.$config,
    app.$theme
  );
</style>

<script client:load>
  customElements.get('xii-preview') === undefined &&
  window.customElements.define('xii-preview', class extends HTMLElement {
    constructor () {
      super();

      // 🥷创建 Shadow DOM
      const shadow = this.attachShadow({ mode: 'open' });

      shadow.innerHTML = `
      <slot name="html"></slot>
      <slot name="scss"></slot>
      <slot name="js"></slot>
    `;
    }
  });
</script>