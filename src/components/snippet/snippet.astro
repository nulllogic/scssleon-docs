---
import { extractor } from './utils/';
// HTML
const html_rendered = (await Astro.slots.render('html'));
// SCSS
const scss_rendered = (await Astro.slots.render('scss'));
// JS
const js_rendered = (await Astro.slots.render('js'));

const {
  title = '',
  preview = false,
  file = null,
  min_height = '',
  inline = false,
  single = true,
  multi_line = true,
  lang = 'js'
} = Astro.props;

const {
  html = null,
  scss = null,
  js = null,
  code = null,
} = await extractor(file, title);

import { Snippet } from './sub';
---
<Snippet client:load
         title={Astro.props.title}
         html={html}
         scss={scss}
         js={js}
         code={code}
         single={single}
         lang={lang}
/>