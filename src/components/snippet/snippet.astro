---
import { Preview } from './';
import { extractor } from './utils/extractor.ts';

import { codeToHtml } from 'shiki';

import type {
  ShikiTransformer,
  ThemeRegistration,
  ThemeRegistrationRaw,
} from 'shiki';

import {
  transformerNotationDiff,
  transformerNotationHighlight,
  transformerNotationFocus,
} from '@shikijs/transformers';

// then later you can use `highlighter.codeToHtml` synchronously
// with the loaded themes and languages.
const code2 = await codeToHtml(
  '// [!code highlight:5]\n' +
  'import {\n' +
  '  transformerNotationDiff,\n' +
  '  // ...\n' +
  '} from \'@shikijs/transformers\'\n' +
  'import {\n' +
  '  codeToHtml,\n' +
  '} from \'shiki\'\n' +
  '\n' +
  '// [!code highlight:3]\n' +
  'console.log(\'Highlighted\')\n' +
  'console.log(\'Highlighted\')\n' +
  'console.log(\'Highlighted\')\n' +
  'console.log(\'hewwo\') // [!code --]\n' +
  'console.log(\'hello\') // [!code ++]\n' +
  'const code = `console.log(\'hello\')`\n' +
  'const html = await codeToHtml(code, {\n' +
  '  lang: \'ts\',\n' +
  '  theme: \'nord\',\n' +
  '  transformers: [\n' +
  '    transformerNotationDiff(), // [!code highlight]\n' +
  '    // ...\n' +
  '  ],\n' +
  'import { codeToHtml } from \'shiki\'\n' +
  '\n' +
  'const code = await codeToHtml(\'foo\\bar\', {\n' +
  '  lang: \'js\',\n' +
  '  theme: \'vitesse-light\',\n' +
  '  transformers: [\n' +
  '    {\n' +
  '      code(node) {\n' +
  '        this.addClassToHast(node, \'language-js\')\n' +
  '      },\n' +
  '      line(node, line) {\n' +
  '        node.properties[\'data-line\'] = line\n' +
  '        if ([1, 3, 4].includes(line))\n' +
  '          this.addClassToHast(node, \'highlight\')\n' +
  '      },\n' +
  '      span(node, line, col) {\n' +
  '        node.properties[\'data-token\'] = `token:${line}:${col}`\n' +
  '      },\n' +
  '    },\n' +
  '  ]\n' +
  '})', {
    lang: 'javascript',
    themes: {
      light: 'github-light-default',
      dark: 'github-dark-default',
    },
    defaultColor: 'light-dark()',
    transformers: [
      transformerNotationDiff(),
      transformerNotationHighlight(),
      transformerNotationFocus(),
    ],
  });

// HTML
const html_rendered = (await Astro.slots.render('html'));
// SCSS
const scss_rendered = (await Astro.slots.render('scss'));
// JS
const js_rendered = (await Astro.slots.render('js'));

const {
  title = '',
  preview = false,
  file = null,
  min_height = '',
  inline = false,
  single = true,
  multi_line = true,
} = Astro.props;

const {
  html = null,
  scss = null,
  js = null,
  code = null,
} = await extractor(file, title);
---
<div class="snippet">
    <div class="tabs">
        <div class="buttons">

        </div>
        <div class="panels">
            <div class="code show-line-numbers" set:html={code2}></div>
        </div>
    </div>
</div>

<style lang="scss">
  @use 'sass:list';
  @use 'sass:string';
  @use 'sass:meta';
  @use 'sass:map';

  @use '~/styles/app.scss' as app;

  $code: (
    border: 1px solid #3d444d,
    border-radius: .425rem,
    _subclasses : (
      'pre.shiki' : (
        text-align: left,
        padding: 0,
      )
    )
  );

  $snippet: (
    border-radius: 0.5rem,
    background: var(--background),
    box-shadow: var(--shadow),
    z-index: 1,
    _subclasses : (
      '.code' : $code,
    )
  );

  @include app.generate-component($snippet, 'snippet', app.$config, app.$theme);
</style>

<style is:global>

  .code {
    pre.shiki {
      border-radius: .425rem;
      text-align: left;
      padding: 0;
      line-height: 1.725;
      display: block;
      margin: 0;

      code {
        display: block;
      }
    }
  }

  .code {

    counter-reset: step;
    counter-increment: step 0;

    & .line {
      display: inline-block;
      width: 100%;

      &:first-child {
        padding-top: 8px;
      }

      &:last-child {
        padding-bottom: 8px;
      }
    }

    & .line.highlighted {
      background-color: rgb(21, 27, 35);
      //width: calc(100% + 48px);
      //margin: 0px -24px;
      //padding: 0px 24px;
      transition: background-color 0.5s;
    }

    & .diff {
      background: rgba(248, 81, 73, 0.1);
    }

    &.show-line-numbers pre.shiki .line.diff:before {

      display: inline-block;
      text-align: center;
      color: #cb7676;
      content: "-";
    }

    & .add {
      background: rgba(46, 160, 67, 0.15);
      width: 100%;

    }

    &.show-line-numbers pre.shiki .line.add:before {
      display: inline-block;
      text-align: center;
      content: "+";
      color: #3dd68c;
    }

    &.show-line-numbers pre.shiki .line:before {
      content: counter(step);
      counter-increment: step;
      width: 2ch;
      margin-right: 1rem;
      margin-left: .525rem;
      display: inline-block;
      text-align: right;
      color: rgba(115, 138, 148, .4)
    }
  }
</style>