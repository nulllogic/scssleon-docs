---
import * as sass from 'sass';
import {Preview} from './';
import {extractor} from './utils/';

import {codeToHtml} from 'shiki';

import type {
  ShikiTransformer,
  ThemeRegistration,
  ThemeRegistrationRaw,
} from 'shiki';

import {
  transformerNotationDiff,
  transformerNotationHighlight,
  transformerNotationFocus,
} from '@shikijs/transformers';
import {snippet_classes} from './utils';

// HTML
const html_rendered = (await Astro.slots.render('html'));
// SCSS
const scss_rendered = (await Astro.slots.render('scss'));
// JS
const js_rendered = (await Astro.slots.render('js'));

const {
  title = '',
  preview = false,
  file = null,
  min_height = '',
  inline = false,
  single = true,
  multi_line = true,
} = Astro.props;

const {
  html = null,
  scss = null,
  js = null,
  code = null,
} = await extractor(file, title);

// then later you can use `highlighter.codeToHtml` synchronously
// with the loaded themes and languages.
const code_formatted = code ? await codeToHtml(code, {
  lang: Astro.props?.lang ? Astro.props?.lang : 'html',
  themes: {
    light: 'github-light-default',
    dark: 'github-dark-default',
  },
  defaultColor: 'light-dark()',
  transformers: [
    transformerNotationDiff(),
    transformerNotationHighlight(),
    transformerNotationFocus(),
  ],
}) : null;

let snippet_classes_css = await snippet_classes();

const snippet_template = code_formatted ? `<div class="code${code_formatted && code_formatted.split('\n').length === 1 ? ' single' : ''}">
    ${code_formatted}
    <xii-button class="clipboard" />
</div>` : `<div slot="code">
    <div class="top">
        <div class="nav">
            <div class="left">
                1
            </div>
            <div class="right">
                2
            </div>
        </div>
    </div>
    <div class="middle">
        <div class="preview">
            ${html}
        </div>
    </div>
    <div class="bottom">
        <div class="nav">
            <div class="left">
                3
            </div>
            <div class="right">
                4
            </div>
        </div>
        <div class="tabs">
            <div class="tab">
                <div>
                    ${code_formatted}
                </div>
                <div>
                    ${code_formatted}
                </div>
                <div>
                    ${code_formatted}
                </div>
            </div>
        </div>
    </div>
</div>`;
---
<xii-snippet/>

<script define:vars={{snippet_template, snippet_classes_css}}>
  const editTemplate = snippet_template;

  class Snippet extends HTMLElement {
    constructor() {

      super();
      const shadow = this.attachShadow({mode: 'open'});
      // 2. Create the constructable stylesheet object
      const sheet = new CSSStyleSheet();
      sheet.replaceSync(snippet_classes_css);

// 3. Attach the stylesheet to the shadow root
      shadow.adoptedStyleSheets = [sheet];

      //   shadow.innerHTML = `
      //   <slot part="code" name="code"></slot>
      // `;
      // this.render();
    }

    render() {
      // Create a temporary template element instance
      const tmpl = document.createElement('template');
      tmpl.innerHTML = editTemplate;

      this.shadowRoot.appendChild(tmpl.content.cloneNode(true));
    }

    // Initialize the component
    init() {
      this.render();
    }

    connectedCallback() {

      if (document.readyState !== 'loading') {
        this.init();
        return;
      }

      document.addEventListener('DOMContentLoaded', () => this.init(), {once: true});

      // Read the message from the data attribute.
      const message = this.dataset.message;
      const button = this.querySelector('button');
      button?.addEventListener('click', () => {
        alert(message);
      });
      this.classList.add('snippet');
      // this.dataset.theme = 'dark';
      // console.log(this.classList);
      //
      // Apply saved theme or system preference on page load
      const saved_theme = localStorage.getItem('theme');

      if (saved_theme) {
        this.dataset.theme = saved_theme;
      } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        this.dataset.theme = 'dark';
      }
    }
  }

  customElements.define('xii-snippet', Snippet);
</script>

<script>
  import {InitButton} from './sub';
  InitButton('<test>', 'test');
</script>