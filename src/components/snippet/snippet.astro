---
import { Preview } from './';
import { extractor } from './utils/extractor.ts';

import { codeToHtml } from 'shiki';

import type {
  ShikiTransformer,
  ThemeRegistration,
  ThemeRegistrationRaw,
} from 'shiki';

import {
  transformerNotationDiff,
  transformerNotationHighlight,
  transformerNotationFocus,
} from '@shikijs/transformers';

// HTML
const html_rendered = (await Astro.slots.render('html'));
// SCSS
const scss_rendered = (await Astro.slots.render('scss'));
// JS
const js_rendered = (await Astro.slots.render('js'));

const {
  title = '',
  preview = false,
  file = null,
  min_height = '',
  inline = false,
  single = true,
  multi_line = true,
} = Astro.props;

const {
  html = null,
  scss = null,
  js = null,
  code = null,
} = await extractor(file, title);

// then later you can use `highlighter.codeToHtml` synchronously
// with the loaded themes and languages.
const code2 = await codeToHtml(code, {
  lang: 'scss',
  themes: {
    light: 'github-light-default',
    dark: 'github-dark-default',
  },
  defaultColor: 'light-dark()',
  transformers: [
    transformerNotationDiff(),
    transformerNotationHighlight(),
    transformerNotationFocus(),
  ],
});
console.log(Astro.props);
---
<div class="snippet">
    <div class="tabs">
        <div class="buttons">

        </div>
        <div class="panels">
            <div class="code show-line-numbers" set:html={code2}></div>
        </div>
    </div>
    <xii-snippet set:html={code2} />
</div>

<script>
  export default class Snippet extends HTMLElement {
    constructor () {
      super();
      const shadow = this.attachShadow({ mode: 'open' });

      shadow.innerHTML = `
      <div class="card-wrapper">
        <!-- Named slot inserts here -->
        <slot name="title"></slot>
        <hr>
        <!-- Unnamed/default slot inserts here -->
        <slot></slot>
      </div>
    `;
    }

    // render () {
    //   return `<div><slot></slot></div>`;
    // }

    connectedCallback () {
      // Read the message from the data attribute.
      const message = this.dataset.message;
      const button = this.querySelector('button');
      button?.addEventListener('click', () => {
        alert(message);
      });
    }
  }

  customElements.define('xii-snippet', Snippet);
</script>

<style lang="scss">
  @use 'sass:list';
  @use 'sass:string';
  @use 'sass:meta';
  @use 'sass:map';

  @use '~/styles/app.scss' as app;

  $code: (
    border: 1px solid #3d444d,
    border-radius: .425rem,
    _subclasses : (
      'pre.shiki' : (
        text-align: left,
        padding: 0,
      )
    )
  );

  $snippet: (
    border-radius: 0.5rem,
    background: var(--background),
    box-shadow: var(--shadow),
    z-index: 1,
    _subclasses : (
      '.code' : $code,
    )
  );

  @include app.generate-component($snippet, 'snippet', app.$config, app.$theme);
</style>

<style is:global>

  .code {
    pre.shiki {
      border-radius: .425rem;
      text-align: left;
      padding: 0;
      line-height: 1.725;
      display: block;
      margin: 0;

      code {
        display: block;
      }
    }
  }

  .code {

    counter-reset: step;
    counter-increment: step 0;

    & .line {
      display: inline-block;
      width: 100%;

      &:first-child {
        padding-top: 8px;
      }

      &:last-child {
        padding-bottom: 8px;
      }
    }

    & .line.highlighted {
      background-color: rgb(21, 27, 35);
      //width: calc(100% + 48px);
      //margin: 0px -24px;
      //padding: 0px 24px;
      transition: background-color 0.5s;
    }

    & .diff {
      background: rgba(248, 81, 73, 0.1);
    }

    &.show-line-numbers pre.shiki .line.diff:before {

      display: inline-block;
      text-align: right;
      color: #cb7676;
      content: "-";
    }

    & .add {
      background: rgba(46, 160, 67, 0.15);
      width: 100%;

    }

    &.show-line-numbers pre.shiki .line.add:before {
      display: inline-block;
      text-align: right;
      content: "+";
      color: #3dd68c;
    }

    &.show-line-numbers pre.shiki .line:before {
      content: counter(step);
      counter-increment: step;
      width: 2ch;
      margin-right: 1rem;
      margin-left: .525rem;
      display: inline-block;
      text-align: right;
      color: rgba(115, 138, 148, .4)
    }
  }
</style>