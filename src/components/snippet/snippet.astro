---
import * as sass from 'sass';
import { Preview } from './';
import { extractor } from './utils/';
import { outline_classes_compile } from './utils/';

import { codeToHtml } from 'shiki';

import type {
  ShikiTransformer,
  ThemeRegistration,
  ThemeRegistrationRaw,
} from 'shiki';

import {
  transformerNotationDiff,
  transformerNotationHighlight,
  transformerNotationFocus,
} from '@shikijs/transformers';
import { snippet_classes } from './utils';

// HTML
const html_rendered = (await Astro.slots.render('html'));
// SCSS
const scss_rendered = (await Astro.slots.render('scss'));
// JS
const js_rendered = (await Astro.slots.render('js'));

const {
  title = '',
  preview = false,
  file = null,
  min_height = '',
  inline = false,
  single = true,
  multi_line = true,
} = Astro.props;

const {
  html = null,
  scss = null,
  js = null,
  code = null,
} = await extractor(file, title);

console.log(html, scss, js, code);

// then later you can use `highlighter.codeToHtml` synchronously
// with the loaded themes and languages.
const code_formatted = code ? await codeToHtml(code, {
  lang: Astro.props?.lang ? Astro.props?.lang : 'html',
  themes: {
    light: 'github-light-default',
    dark: 'github-dark-default',
  },
  defaultColor: 'light-dark()',
  transformers: [
    transformerNotationDiff(),
    transformerNotationHighlight(),
    transformerNotationFocus(),
  ],
}) : null;

const snippet_classes_css = await snippet_classes();
console.log(code_formatted);
---
<xii-snippet class:list={[
  {
    single: (code_formatted && code_formatted.split('\n').length === 1) ??
      false,
  }]}>
  {code_formatted ? (
          <div class="code" slot="code">
              <Fragment set:html={code_formatted} />
              <a class="clipboard has-tooltip btn" href="#" type="button" style="font-size: 0.925rem;gap: 5px;">
                  <svg xmlns="http://www.w3.org/2000/svg"
                       width="16"
                       height="16" viewBox="0 0 24 24"
                       fill="none"
                       stroke="currentColor"
                       stroke-width="2"
                       stroke-linecap="round"
                       stroke-linejoin="round"
                  >
                      <rect width="14" height="14" x="8"
                            y="8"
                            rx="2"
                            ry="2"></rect>
                      <path stroke="rgb(74, 109, 71)"
                            fill="none"
                            fill-rule="evenodd"
                            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                            clip-rule="evenodd"></path>
                      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                  </svg>
                  <span class="text">Copy</span>
              </a>
          </div>
  ) : (
          <div>
              <div slot="preview" set:html={html}></div>
              <div slot="html" set:html={html}></div>
              <div slot="scss" set:html={scss}></div>
              <div slot="js" set:html={js}></div>
          </div>
  )}
</xii-snippet>

<script define:vars={{ snippet_classes_css }} is:inline>
  class Snippet extends HTMLElement {
    constructor () {
      super();
      const shadow = this.attachShadow({ mode: 'open' });

      shadow.innerHTML = `
      <style>
        
        ::slotted(code) {
            position: relative;
        }
        
        :host .code .btn {
            right: 8px;
            top: 8px;
            position: absolute;
            --xii-padding: 0.25rem 0.5rem;
        }
        
        :host(.single) .code .btn {
            top: 50%;
            transform: translateY(-50%);
            --xii-padding: 0.25rem;
        }
        
        :host(.single) .code .btn .text {
            display: none;
        }
        
        ${snippet_classes_css}
      </style>
      
      <slot name="preview"></slot>
      <slot name="html"></slot>
      <slot name="scss"></slot>
      <slot name="js"></slot>
      <slot part="code" name="code"></slot>
    `;
    }

    // render () {
    //   return `<div><slot></slot></div>`;
    // }

    connectedCallback () {
      // Read the message from the data attribute.
      const message = this.dataset.message;
      const button = this.querySelector('button');
      button?.addEventListener('click', () => {
        alert(message);
      });
      this.classList.add('snippet');
      // this.dataset.theme = 'dark';
      // console.log(this.classList);
      //
      // Apply saved theme or system preference on page load
      const saved_theme = localStorage.getItem('theme');

      if (saved_theme) {
        this.dataset.theme = saved_theme;
      } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        this.dataset.theme = saved_theme;
      }
    }
  }

  customElements.define('xii-snippet', Snippet);
</script>

<style lang="scss" is:global>
  @use 'sass:list';
  @use 'sass:string';
  @use 'sass:meta';
  @use 'sass:map';

  @use '~/styles/app.scss' as app;

  $code: (
    border: 1px solid #3d444d,
    border-radius: .425rem,
    padding: 0,
    line-height: 1.72,
    _subclasses : (
      'code' : (
        background: none,
        display: block,
        counter-reset: step,
        counter-increment: step 0,
        _subclasses: (
          '& .line' : (
            display: inline-block,
            width: 100%,
            padding: 0 .825rem,
            _subclasses: (
              '&:first-child' : (
                padding-top: 8px
              ),
              '&:last-child' : (
                padding-bottom: 8px
              ),
            )
          ),
          '& .line.highlighted' : (
            background-color: rgb(21, 27, 35),
            //width: calc(100% + 48px),
            //margin: 0px -24px,
            //padding: 0px 24px,
            transition: background-color 0.5s,
          ),
          '& .diff' : (
            background: rgba(248, 81, 73, 0.1),
          ),
          '&[show-line-numbers] pre.shiki .line.diff:before' : (
            display: inline-block,
            text-align: right,
            color: #cb7676,
            content: "-",
          ),
          '& .add' : (
            background: rgba(46, 160, 67, 0.15),
            width: 100%,
          ),
          '&[show-line-numbers] pre.shiki .line.add:before' : (
            display: inline-block,
            text-align: right,
            content: "+",
            color: #3dd68c,
          ),
          '&[show-line-numbers] pre.shiki .line:before' : (
            content: counter(step),
            counter-increment: step,
            width: 2ch,
            margin-right: 1rem,
            margin-left: .525rem,
            display: inline-block,
            text-align: right,
            color: rgba(115, 138, 148, .4),
          )
        )
      )
    )
  );

  $snippet: (
    /*background: var(--background),*/
    box-shadow: var(--shadow),
    z-index: 1,
    border-radius: .425rem,
    text-align: left,
    padding: 0,
    display: block,
    margin: 0,
    _subclasses : (
      '.shiki' : $code,
    )
  );

  @include app.generate-component($snippet, 'snippet', app.$config, app.$theme);
</style>

<style is:global>

  .code {
    pre.shiki {
      border-radius: .425rem;
      text-align: left;
      padding: 0;
      line-height: 1.725;
      display: block;
      margin: 0;

      code {
        display: block;
      }
    }
  }

  .code {

    counter-reset: step;
    counter-increment: step 0;

    & .line {
      display: inline-block;
      width: 100%;

      &:first-child {
        padding-top: 8px;
      }

      &:last-child {
        padding-bottom: 8px;
      }
    }

    & .line.highlighted {
      background-color: rgb(21, 27, 35);
      //width: calc(100% + 48px);
      //margin: 0px -24px;
      //padding: 0px 24px;
      transition: background-color 0.5s;
    }

    & .diff {
      background: rgba(248, 81, 73, 0.1);
    }

    &.show-line-numbers pre.shiki .line.diff:before {

      display: inline-block;
      text-align: right;
      color: #cb7676;
      content: "-";
    }

    & .add {
      background: rgba(46, 160, 67, 0.15);
      width: 100%;

    }

    &.show-line-numbers pre.shiki .line.add:before {
      display: inline-block;
      text-align: right;
      content: "+";
      color: #3dd68c;
    }

    &.show-line-numbers pre.shiki .line:before {
      content: counter(step);
      counter-increment: step;
      width: 2ch;
      margin-right: 1rem;
      margin-left: .525rem;
      display: inline-block;
      text-align: right;
      color: rgba(115, 138, 148, .4)
    }
  }
</style>