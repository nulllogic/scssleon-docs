---
import { extractor } from './utils/';
// HTML
const html_rendered = (await Astro.slots.render('html'));
// SCSS
const scss_rendered = (await Astro.slots.render('scss'));
// JS
const js_rendered = (await Astro.slots.render('js'));

const {
  title = '',
  preview = false,
  file = null,
  min_height = '',
  inline = false,
  single = false,
  multi_line = true,
  lang = 'js',
} = Astro.props;

const {
  html = null,
  scss = null,
  js = null,
  code = null,
} = await extractor(file, title);

import { Snippet } from './sub';
import clsx from 'clsx';
import styles from './sub/snippet.module.scss';
// import Code from './sub/code.tsx';
import Button from './sub/button.tsx';
import Code from './sub/code.astro';
import Preview from './sub/preview.ts';

// title={Astro.props.title}
// html={html}
// scss={scss}
// js={js}
// code={code}
// single={single}
// lang={lang}
const lines = code ? code.split(/\r\n|\r|\n/).length : null;
---
<div class:list={['snippet', { 'single': single }]}>
  {(!single || (lines && lines > 1)) && (
          <div class="top">
              <div class="nav">
                  <div class="left">
                      <div class="title">
                        {Astro.props.title}
                      </div>
                  </div>
                  <div class="right">
                    {!code && (
                            <div class="btn-group" role="group"
                                 aria-label="Basic example">
                                <button type="button" class="btn">Left</button>
                                <button type="button" class="btn">Middle
                                </button>
                                <button type="button" class="btn">Right</button>
                            </div>
                    )}
                  </div>
              </div>
          </div>
  )}

    <div class="middle">
      {preview && (
              <div class="preview">
                  <xii-preview>
                      <div slot="html" set:html={html}></div>
                    {scss && (
                            <div slot="scss">
                              {scss}
                            </div>
                    )}
                    {js && (
                            <div slot="js">
                              {js}
                            </div>
                    )}
                  </xii-preview>
              </div>
      )}
      {code && (
              <Code code={code} lang={lang} single={single}
                    oneline={lines && lines === 1}/>
              <Button small={lines && lines === 1}/>
      )}
    </div>
  {!single && (
          <div class="bottom">
              <div class="nav">
                  <div class="left">
                      <div class="btn-group" role="group"
                           aria-label="Basic example">
                          <button type="button" class="btn">Left</button>
                          <button type="button" class="btn">Middle
                          </button>
                          <button type="button" class="btn">Right</button>
                      </div>
                  </div>
                  <div class="right">
                      <button type="button" class="btn">Right</button>
                  </div>
              </div>
              <div class="tabs">
                  <div class="tab">
                      <Code code={html} lang={'html'}
                            show_line_numbers={true}/>
                  </div>
                  <div class="tab">
                      <Code code={scss} lang={'scss'}
                            show_line_numbers={true}/>
                  </div>
                  <div class="tab">
                      <Code code={js} lang={'js'} show_line_numbers={true}/>
                  </div>
              </div>
          </div>
  )}
</div>

<style lang="scss">
  @use '~/styles/app.scss' as app;

  $snippet-top: (
    background: #0d1117,
    border-radius: .425rem .425rem 0 0,
    padding: 0 .825rem,
    border-bottom: 1px solid #333434,
    _subclasses : (
      '.nav' : (
        justify-content : space-between,
        _subclasses : (
          '.title' : (
          )
        )
      ),
    )
  );

  $snippet-middle: (
    background: #0d1117,
    border-radius: 0 0 0.425rem 0.425rem,
    position: relative,
    _subclasses : (
      '.preview' : (
        padding: 0 .825rem,
        border-bottom: 1px solid #333434,
      ),
      ':global(.btn)' : (
        position: absolute,
        top: 8px,
        right: 8px,
        _subclasses : (
          '&.small' : (
            top: 50%,
            transform: translateY(-50%)
          )
        )
      )
    )
  );


  $snippet-bottom: (
    background: #0d1117,
    border-radius: 0 0 0.425rem 0.425rem,
    _subclasses : (
      '.nav' : (
        padding: 0 .825rem,
        justify-content : space-between,
        border-bottom: 1px solid #333434,
      ),
      '.tabs' : (
        _subclasses : (
          '.tab' : (
            _subclasses : (
              '&:first-child' : (
                display: block,
              )
            ),
            display: none
          )
        )
      )
    )
  );

  $snippet: (
    position: relative,
    z-index: 1,
    text-align: left,
    padding: 0,
    display: block,
    margin: 0,
    border: 1px solid #3d444d,
    border-radius: .425rem,
    _subclasses : (
      '.top' : $snippet-top,
      '.middle' : $snippet-middle,
      '.bottom' : $snippet-bottom,
      '&.single' : (
        _subclasses : (
          '.middle' : (
            border-radius: .425rem,
          )
        )
      )
    )
  );

  @include app.generate-component(
    $snippet,
    '.snippet',
    app.$config,
    app.$theme
  );
</style>

<script client:load>
  window.customElements.define('xii-preview', class extends HTMLElement {
    constructor () {
      super();

      // 创建Shadow DOM
      const shadow = this.attachShadow({ mode: 'open' });

      // 添加样式和内容
      shadow.innerHTML = `
      <style>
        button {
          background: linear-gradient(45deg, #ff6b6b, #4ecdc4);
          border: none;
          border-radius: 25px;
          color: white;
          cursor: pointer;
          font-size: 16px;
          padding: 12px 24px;
          transition: transform 0.2s;
        }
        
        button:hover {
          transform: scale(1.05);
        }
      </style>
      <slot name="html"></slot>
    `;
    }
  });
</script>