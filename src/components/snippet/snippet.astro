---
import { extractor } from './utils/';

const {
  title = '',
  preview = false,
  file = null,
  min_height = null,
  inline = false,
  single = false,
  multi_line = true,
  lang = 'js',
} = Astro.props;

const {
  html = null,
  scss = null,
  js = null,
  code = null,
} = await extractor(file, title);

import { Button } from './sub';
import { Code } from './sub';
import { Preview } from './sub';

import { component_classes } from './utils/classes_generator.ts';

const lines = code ? code.split(/\r\n|\r|\n/).length : null;
---
<div class:list={['snippet card', { 'single': single }]}>
  {(!single || (lines && lines > 1)) && (
          <div class="top">
              <div class="nav">
                  <div class="left">
                      <div class="title"
                           set:html={Astro.props.title.replace(/\*(.*?)\*/g,
                             '<span class="bold">$1</span>')}>
                      </div>
                  </div>
                  <div class="right">
                    {!code && (
                            <div class="btn-group separated" role="group"
                                 aria-label="Basic example"
                                 style="--xii-gap: .425rem;">
                                <Button class="toggle outline" small
                                        icon={'outline'}/>
                                <Button class="toggle color_scheme" small
                                        icon={'color_scheme'}/>
                            </div>
                    )}
                  </div>
              </div>
          </div>
  )}

    <div class="middle">
      {preview && (
              <Preview min_height={min_height}>
                  <Fragment slot="html" set:html={html} is:raw/>
                  <Fragment slot="scss" set:html={scss} is:raw/>
                  <Fragment slot="js" set:html={js} is:raw/>
              </Preview>
      )}
      {code && (
              <Code code={code} lang={lang} single={single}
                    oneline={lines && lines === 1}/>
              <div class:list={[
                'wrapper',
                { 'vertical': lines && lines === 1 }]}>
                  <Button class="clipboard" small={lines && lines === 1}
                          icon={'clipboard'} tooltip/>
              </div>
      )}
    </div>
  {!single && (
          <div class="bottom">
              <div class="nav">
                  <div class="left">
                      <Button class="link active html5 tab" title="HTML"
                              icon="html5" badge={1}/>
                    {scss && (
                            <Button class="link scss tab" title="SCSS"
                                    icon="scss"/>
                    )}
                    {js && (
                            <Button class="link js tab" title="JS" icon="js"/>
                    )}
                  </div>
                  <div class="right">
                      <div class="wrapper">
                          <Button class="clipboard" small icon="clipboard">
                              Right
                          </Button>
                      </div>
                  </div>
              </div>
              <div class="tabs">
                  <div class="tab active">
                      <Code code={html} lang={'html'}
                            show_line_numbers={true}/>
                  </div>
                {scss && (
                        <div class="tab">
                            <Code code={scss} lang={'scss'}
                                  show_line_numbers={true}/>
                        </div>
                )}
                {js && (
                        <div class="tab">
                            <Code code={js} lang={'js'}
                                  show_line_numbers={true}/>
                        </div>
                )}
              </div>
          </div>
  )}
</div>

<style lang="scss">
  @use 'sass:map';
  @use 'sass:string';

  @use '~/styles/app.scss' as app;

  $snippet-top: (
    background: var(--section-background),
    border-bottom: var(--border),
    border-radius: .425rem .425rem 0 0,
    padding: .525rem .825rem,
    min-height: 46px,
    align-items: center,
    display: flex,
    _subclasses : (
      '.nav' : (
        width: 100%,
        justify-content : space-between,
        _subclasses : (
          '.title' : (
            _subclasses : (
              ':global(.bold)' : (
                font-weight: 500,
                display: inline-block,
                padding: 0 .25rem 0 0,
              )
            )
          )
        )
      ),
    ),
  );

  $snippet-middle: (
    /*border-radius: 0 0 0.425rem 0.425rem,*/
    position: relative,
    border-bottom: var(--border),
    _subclasses : (
      '.wrapper' : (
        position: absolute,
        top: 8px,
        right: 8px,
        display: inline-block,
        _subclasses : (
          '&.vertical' : (
            top: 50%,
            transform: translateY(-50%)
          )
        )
      )
    )
  );


  $snippet-bottom: (
    background: var(--section-background),
    border-bottom: var(--border),
    border-radius: 0 0 0.425rem 0.425rem,
    _subclasses : (
      '> .nav' : (
        padding: .525rem .825rem,
        justify-content : space-between,
        border-bottom: var(--border),
        _subclasses : (
          '.left' : (
            --gap: .425rem,
            text-decoration: none,
            display: flex,
            gap: var(--gap),
            _subclasses : (
              '.btn.link' : (
                text-decoration: none,
                --padding: .365rem .45rem,
                _subclasses : (
                  '&:hover' : (
                    background: var(--background),
                  ),
                  '&.active' : (
                    font-weight: 700,
                    background: var(--background),
                    position: relative,
                    _subclasses : (
                      ':global(.text)' : (
                        // tweaking to make text look better
                        letter-spacing: 0,
                        font-size: .975rem,
                        padding-right: 0,
                        margin-top: 0,
                      ),
                      '&:after' : (
                        content: "",
                        height: 2px,
                        pointer-events: none,
                        background-color: oklch(0.7304 0.1502 34.05),
                        position: absolute,
                        width: 100%,
                        left:0,
                        bottom: -9px,
                        right: 0,
                      )
                    )
                  ),
                  ':global(.text)' : (
                    display: inline-block,
                    vertical-align: middle,
                    min-height: 1rem,
                    // tweaking to make text look better
                    letter-spacing: 0.75px,
                    font-size: 0.925rem,
                    padding-right: 1px,
                    margin-top: 1px,
                    position: relative,
                    _atrule : (
                      '@media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi), (min-resolution: 2dppx)' : (
                        margin-top: 0,
                      )
                    )
                  )
                ),
                _colors : (
                  'light' : (
                    background : #818b981f
                  ),
                  'dark' : (
                    background : #656c7633
                  )
                )
              )
            )
          )
        )
      ),
      '.tabs' : (
        _subclasses : (
          '.tab' : (
            _subclasses : (
              '&.active' : (
                display: block,
              )
            ),
            display: none
          )
        )
      )
    ),
  );

  $snippet: (
    position: relative,
    z-index: 1,
    text-align: left,
    padding: 0,
    display: block,
    margin: 0,
    background: none,
    /*border: 1px solid #3d444d,*/
    /*border-radius: .425rem,*/
    _subclasses : (
      '.top' : $snippet-top,
      '.middle' : $snippet-middle,
      '.bottom' : $snippet-bottom,
      '&.single' : (
        _subclasses : (
          '.middle' : (
            border-radius: .425rem,
            border-bottom: none,
          )
        )
      )
    ),
    _colors : (
      'light' : (
        section-background: rgb(248, 249, 250),
        section-border: 1px solid rgb(222, 226, 230),
      ),
      'dark' : (
        section-background: #0d1117,
        section-border: 1px solid #333434,
      )
    )
  );

  @include app.generate-component(
    $snippet,
    '.snippet',
    app.$config,
    app.$theme
  );
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const snippets = document.querySelectorAll('.snippet');
    snippets.forEach((snippet) => {

      const top_buttons = snippet.querySelectorAll('.top .btn');

      top_buttons.forEach((button, index) => {
        switch (index) {
          // Outline button click
          case 0 :
            button.addEventListener('click', (e) => {
              e.preventDefault();
              snippet.querySelector('.preview > xii-preview')?.
                shadowRoot.
                querySelector('.wrapper').
                classList.
                toggle('outline');
            });
            break;
        }
      });

      const middle_buttons = snippet.querySelectorAll('.middle .btn');

      middle_buttons.forEach((button, index) => {
        console.log(button);
      });
    });
  });
</script>

<script>

  document.querySelectorAll('.snippet').forEach((snippet) => {

    // Tabs

    // Checking first, if element exist
    if (snippet.querySelector('.topnav .navbar')) {
      const nav_items_top_left = snippet.querySelectorAll(
        '.topnav .navbar .left .nav .item .link');

    }

    // @TODO rewrite a bit code below to make it look nicer

    if (snippet.querySelector('.bottom .nav .left')) {
      const tabs_nav_items = snippet.querySelectorAll(
        '.bottom .nav .left .tab');
      const tab_items = snippet.querySelectorAll('.bottom .tabs .tab');

      tabs_nav_items.forEach((nav, index) => {
        nav.addEventListener('click', function (e) {
          e.preventDefault();
          console.log(nav);

          tabs_nav_items.forEach(
            element => element.classList.remove('active'));
          nav.classList.add('active');

          tab_items.forEach(element => element.classList.remove('active'));
          tab_items[index].classList.add('active');
        });
      });

    }

    const preview = snippet.querySelector('.preview');

    if (preview) {
      // Proceed, if preview is enabled

      const resizer = snippet.querySelector('.preview .resizer .drag');
      if (resizer) {
        const container_limit = Math.round(preview.clientWidth / 1.5);

        resizer.onmousedown = (event) => {
          event.preventDefault();

          const original_margin = parseFloat(
            isNaN(preview.style.marginRight) ? preview.style.marginRight : 0,
          );
          const original_mouse_x = event.pageX;

          const event_drag_start_handler = (event) => {
            const width = original_margin - (event.pageX - original_mouse_x);
            if (width < container_limit && width > 0) {
              preview.style.marginRight = width + 'px';
            } else if (width < 0) {
              preview.style.marginRight = 0 + 'px';
            }
          };

          const event_drag_end_handler = (event) => {
            document.documentElement.classList.remove('dragging');
            preview.classList.remove('is_resizing');
            document.removeEventListener('mousemove', event_drag_start_handler);
            document.removeEventListener('mouseup', event_drag_end_handler);
          };

          document.documentElement.classList.add('dragging');
          preview.classList.add('is_resizing');
          document.addEventListener('mousemove', event_drag_start_handler);
          document.addEventListener('mouseup', event_drag_end_handler,
            { once: true });
        };
      }
    }

    const buttons = snippet.querySelectorAll('.btn');

    if (buttons.length > 0) {
      buttons.forEach((button, index) => {

        if (button.classList.contains('toggle') &&
          button.classList.contains('color_scheme')) {
          button?.classList.add(localStorage.getItem('theme'));
        }

        button.addEventListener('click', (e) => {
          e.preventDefault();

          if (button.classList.contains('clipboard')) {

            if (!button?.classList.contains('clicked')) {
              button?.classList.add('clicked');
              setTimeout(() => {
                button?.classList.remove('clicked');
              }, 1250);
            }

            // let tooltip = button.querySelector('.tooltip')
            //
            // tooltip?.classList.add('show')
            //
            // let random_tooltip_index = Math.floor(Math.random() * 5)
            //
            // tooltip?.querySelectorAll(':scope.funky > *').forEach((text, index) => {
            //     text.setAttribute('hidden', '')
            //     if (index === random_tooltip_index) {
            //         text.removeAttribute('hidden')
            //     }
            // })
            //
            // let copied_text = snippet.querySelector('.astro-code code')?.innerText;
            //
            // navigator.clipboard.writeText(copied_text).then(function () {
            //     /* clipboard successfully set */
            //     setTimeout(() => {
            //         button.querySelector('.tooltip')?.classList.remove('show')
            //     }, 800)
            // }, function () {
            //     /* clipboard write failed */
            // })
          }

          // if (button.classList.contains('toggle_outline')) {
          //   const event = new Event('toggle_outline');
          //   document.dispatchEvent(event);
          // }
          //

          if (button.classList.contains('color_scheme')) {
            const event = new Event('dark_mode_toggle');
            document.dispatchEvent(event);

            button.classList.add('clicked');

            if (button.classList.contains('dark')) {
              button.classList.remove('dark');
              button.classList.add('light');
            } else {
              button.classList.remove('light');
              button.classList.add('dark');
            }
            // button.classList.toggle('clicked');
          }

          if (button.classList.contains('outline')) {
            button.classList.toggle('clicked');
          }

        });
      });
    }
  });
</script>